  <Block BlockType="SubSystem" Name="Transmission" SID="25">
    <PortCounts in="3" out="2"/>
    <P Name="Position">[395, 180, 450, 300]</P>
    <P Name="ZOrder">-8</P>
    <P Name="FontSize">14</P>
    <PortProperties>
      <Port Type="out" Index="1">
        <P Name="Name">ImprellerTorque</P>
      </Port>
